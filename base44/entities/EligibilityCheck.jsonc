      "description": "\u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05ea\u05e7\u05d5\u05e4\u05ea \u05d4\u05e4\u05d9\u05e6\u05d5\u05d9"
    },
    "decline_percent": {
