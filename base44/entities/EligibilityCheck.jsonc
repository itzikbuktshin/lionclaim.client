      "description": "\u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05e9\u05e0\u05ea\u05d9\u05d5\u05ea \u05d1\u05e8\u05d5\u05d8\u05d5 2025"
    },
    "base_revenue": {
      "type": "number",
      "description": "\u05d4\u05db\u05e0\u05e1\u05d5\u05ea \u05ea\u05e7\u05d5\u05e4\u05ea \u05d1\u05e1\u05d9\u05e1 (\u05de\u05e8\u05e5-\u05d0\u05e4\u05e8\u05d9\u05dc 2025)"
    },
    "compensation_revenue": {
